# Copy this file to .env for local development. Never commit .env to Git.

# ==============================================================================
# 🐘 SUPABASE POSTGRESQL & STORAGE (Cloud Deployment)
# ==============================================================================
# Supabase PostgreSQL connection URI (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres.yourprojectref:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API (Project Settings -> API -> Project URL & Project API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=dam-assets

# ==============================================================================
# 🌐 APPLICATION SETTINGS
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# 📲 SMS GATEWAY CONFIGURATION (Twilio Verify & SMS)
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
FAST2SMS_API_KEY=

# ==============================================================================
# 🔐 DIGILOCKER / KWIK.ID CREDENTIALS
# ==============================================================================
KWIKID_AUTH_TOKEN=
KWIKID_BASE_URL=https://verify.getkwikid.com
CLIENT_CALLBACK_URL=http://localhost:3000/api/digilocker/callback
